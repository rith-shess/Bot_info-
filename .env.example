# ===================================================
# Telegram Product Catalog Chatbot & Admin Dashboard
# Environment Configuration
# ===================================================

# Telegram Bot Token (obtained from @BotFather on Telegram)
# Example: 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
BOT_TOKEN=

# Admin Authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=AdminSecurePassword123!

# Server Port
PORT=3000

# Express Session Secret key
SESSION_SECRET=super_secret_session_key_change_in_production_123456

# Base URL for public links (defaults to http://localhost:PORT)
# For a live shop use your public https address, e.g. https://shop.example.com
# Videos bigger than 49MB are sent to customers as a link on this address.
BASE_URL=http://localhost:3000

# Maximum size of one product video in MB (default 1024 = 1GB)
MAX_VIDEO_MB=1024
